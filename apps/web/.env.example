# Akun Admin awal, hanya dibaca oleh seed (npx prisma db seed) lalu disimpan
# sebagai hash scrypt di tabel users. Kata sandi minimal 15 karakter.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Koneksi PostgreSQL (compose.yaml di root); samakan dengan nilai di root .env
DATABASE_URL=postgresql://ganti_user_contoh:ganti_kata_sandi_contoh@127.0.0.1:5433/ganti_nama_db_contoh


# Folder penyimpanan PDF versi. Kosong = apps/web/storage (diabaikan Git).
# Harus di luar folder public/; aplikasi menolak lokasi di dalamnya.
KYRION_STORAGE_DIR=

# Lokasi berkas kunci induk integritas versi (F-31): satu baris 64 karakter hex.
# Harus di LUAR repository, dibuat dengan skrip buat-kunci (menyusul), dan jangan
# pernah di-commit. Tanpa berkas yang valid, unduhan PDF versi ditolak (gagal tertutup).
KYRION_MASTER_KEY_FILE=

# Pengirim email. EMAIL_ADAPTER: "memori" | "konsol" | "mailtrap". Saat pengembangan
# isi "konsol". Kosong atau tak dikenal ditolak (gagal tertutup). "memori" dan
# "konsol" hanya diizinkan bila NODE_ENV "development" atau "test".
EMAIL_ADAPTER=
# Alamat pengirim (wajib untuk mailtrap).
EMAIL_FROM=
# Token API Mailtrap (wajib untuk mailtrap); jangan di-commit.
MAILTRAP_API_TOKEN=
# Angka pada URL sandbox Mailtrap (wajib untuk mailtrap).
MAILTRAP_SANDBOX_ID=
# Better Auth: rahasia minimal 32 karakter, jangan di-commit; URL dasar aplikasi
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
