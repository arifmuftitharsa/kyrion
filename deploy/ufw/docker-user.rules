# BEGIN KYRION-DOCKER-USER
# Pembatas port yang dipublikasikan Docker (80 dan 443 milik Nginx). Risiko: R-09,T-23.
*filter
:DOCKER-USER - [0:0]
-A DOCKER-USER -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN
-A DOCKER-USER -i enp0s8 -s 192.168.56.0/24 -p tcp -m conntrack --ctorigdstport 80 -j RETURN
-A DOCKER-USER -i enp0s8 -s 192.168.56.0/24 -p tcp -m conntrack --ctorigdstport 443 -j RETURN
-A DOCKER-USER -i enp0s8 -j DROP
-A DOCKER-USER -i enp0s3 -j DROP
-A DOCKER-USER -j RETURN
COMMIT
# END KYRION-DOCKER-USER
